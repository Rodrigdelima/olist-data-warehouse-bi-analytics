--------------------------------------------------------------------
-- Camada: DW
-- Tabela: fato_pedidos
-- Descrição: Fato consolidado com métricas logísticas e financeiras
--------------------------------------------------------------------

-- Remove a fato e as views que dependem dela de forma segura
DROP TABLE IF EXISTS dw.fato_pedidos CASCADE;

-- Cria a fato completa com todas as métricas do projeto Olist
CREATE TABLE dw.fato_pedidos AS
SELECT 
    o.order_id,
    o.customer_id,
    oi.product_id,
    oi.seller_id,
    -- Chave de ligação para a dim_calendario no Power BI
    o.order_purchase_timestamp::DATE AS data_sk, 
    oi.price AS venda_bruta,
    oi.freight_value AS frete_total,
    -- Métricas de Logística (Lead Time)
    EXTRACT(DAY FROM (o.order_delivered_customer_date - o.order_purchase_timestamp)) AS lead_time_dias,
    -- Flag de Atraso (Necessário para vw_atraso_vendedores e vw_sazonalidade_atrasos)
    CASE 
        WHEN o.order_delivered_customer_date > o.order_estimated_delivery_date THEN 1 
        ELSE 0 
    END AS pedido_atrasado,
    -- Nota da Avaliação (Necessário para vw_impacto_atraso_avaliacao)
    r.review_score
FROM raw.orders o
JOIN raw.order_items oi ON o.order_id = oi.order_id
LEFT JOIN raw.order_reviews r ON o.order_id = r.order_id
WHERE o.order_status = 'delivered';

-- Validação final
SELECT * FROM dw.fato_pedidos LIMIT 5;

-- 3. Validação simples para garantir que a coluna data_sk está lá
SELECT * FROM dw.fato_pedidos LIMIT 5;

----------------------------------------------------------------
-- validação
-- quantidade total de registros
SELECT COUNT(*) FROM dw.fato_pedidos;
-- quantidade de pedidos únicos
SELECT COUNT(DISTINCT order_id) FROM dw.fato_pedidos;
-- quantidade de clientes únicos
SELECT COUNT(DISTINCT customer_id) FROM dw.fato_pedidos;
-- quantidade de vendedores únicos
SELECT COUNT(DISTINCT seller_id) FROM dw.fato_pedidos;
-- média da receita total por pedido
SELECT AVG(receita_total) AS media_receita_pedido FROM dw.fato_pedidos
-- média do frete total por pedido
SELECT AVG(frete_total) AS media_frete_pedido FROM dw.fato_pedidos
-- média do lead time em dias
SELECT AVG(lead_time_dias) AS media_lead_time FROM dw.fato_pedidos;
-- distribuição das avaliações dos clientes
SELECT review_score, COUNT(*) AS total_reviews FROM dw.fato_pedidos GROUP BY review_score ORDER BY review_score;
-- análise de correlação entre atraso e avaliação dos clientes
SELECT
    pedido_atrasado,
    COUNT(*) AS total_pedidos,
    AVG(lead_time_dias) AS media_lead_time,
    AVG(review_score) AS media_nota
FROM dw.fato_pedidos
GROUP BY pedido_atrasado
ORDER BY pedido_atrasado;

